NODE_ENV=production
PORT=8080
TRUST_PROXY=1                     # reverse proxy ortida nechta hop (nginx = 1)

# --- Auth (mobil ilova JWT'si). Yaratish: openssl rand -base64 48 | tr -d '=+/' ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=30d

# --- Ilova -> shu servis (restoran-api.lokma.uz) ---
# Ixtiyoriy umumiy parol (Android env.properties dagi API_GATEWAY_PASSWORD bilan bir xil). APK ichida ochiq,
# shuning uchun bu himoya emas, faqat qo'pol filtr. Haqiqiy himoya: JWT + restaurantId.
GATEWAY_INBOUND_PASSWORD=
GATEWAY_INBOUND_HEADER=x-gateway-password

# --- Kirish rejimi ---
# pin         : login = Restoran ID, parol = PIN (mavjud server bilan hozir ishlaydi)
# credentials : login = restoranning o'z logini, parol = o'z paroli (main serverda POST /app/service/auth/login kerak, README'ga qarang)
AUTH_MODE=pin

# --- Shu servis -> lakmago-server "Android Gateway" (servis yo'li /app/service/{restaurantId}/...) ---
UPSTREAM_MODE=gateway             # gateway | mock (mock faqat development, production'da rad etiladi)
API_GATEWAY_URL=https://api.lokma.uz
API_GATEWAY_HEADER=x-gateway-key
# lakmago-server .env dagi GATEWAY_SERVICE_KEY bilan BIR XIL (kamida 24 belgi: openssl rand -hex 32).
# Serverda GATEWAY_ALLOWED_IPS ga shu servisning chiquvchi IP manzili yozilgan bo'lishi shart.
API_GATEWAY_PASSWORD=

# --- lakmago-server -> shu servis: buyurtma hodisalari (POST /internal/orders/events, x-webhook-secret) ---
# lakmago-server .env dagi BFF_WEBHOOK_SECRET bilan bir xil; serverda BFF_BASE_URL=https://restoran-api.lokma.uz
INTERNAL_WEBHOOK_SECRET=change-me-too

# --- FCM (Firebase console -> Service accounts -> Generate key). Bo'sh bo'lsa push o'chiq, Socket.IO ishlayveradi ---
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Ixtiyoriy ---
CORS_ORIGINS=
DEVICE_STORE_FILE=./data/devices.json

# --- Buyurtmani yakunlashni nazorat qilish (delivery reminder) ---
# "Yetkazilmoqda" dan REMINDER_DELAY_MINUTES keyin 1-eslatma, keyin har REPEAT daqiqada, MAX_COUNT martagacha.
# DELAY serverdagi "restoran Yetkazildi'ni tasdiqlay oladi" qoidasi (30 daqiqa) bilan bir xil bo'lsin.
# Avtomatik yakunlash YO'Q — faqat eslatma.
REMINDER_DELAY_MINUTES=30
REMINDER_REPEAT_MINUTES=30
REMINDER_MAX_COUNT=3
REMINDER_TICK_SECONDS=30
REMINDER_STORE_FILE=./data/reminders.json

# --- Ilova versiyasi siyosati (GET /restaurant/v1/app/version) ---
ANDROID_MIN_VERSION=1.0.0
ANDROID_LATEST_VERSION=1.0.0
ANDROID_FORCE_UPDATE=false

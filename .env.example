NODE_ENV=production
PORT=8080

# --- Auth (mobil ilova JWT'si) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=30d

# --- Mavjud LokmaGo backend (API gateway orqali) ---
UPSTREAM_MODE=gateway            # gateway | mock (mock faqat development)
API_GATEWAY_URL=https://gateway.lokmago.uz
API_GATEWAY_PASSWORD=change-me
API_GATEWAY_HEADER=x-gateway-password

# --- Mobil ilova -> gateway -> shu servis. Bo'sh bo'lmasa har bir so'rovda (REST + Socket.IO)
#     API_GATEWAY_HEADER sarlavhasida shu parol talab qilinadi (Android env.properties bilan bir xil).
GATEWAY_INBOUND_PASSWORD=change-me
TRUST_PROXY=1

# --- Ilova -> shu servis: umumiy gateway paroli (Android API_GATEWAY_PASSWORD bilan bir xil). Bo'sh = tekshirilmaydi.
# REST va Socket.IO handshake'ida tekshiriladi. Haqiqiy autentifikatsiya baribir JWT.
GATEWAY_INBOUND_PASSWORD=
TRUST_PROXY=1                     # reverse proxy ortida nechta hop (nginx = 1)

# --- lakmago-server yangi buyurtma yaratganda shu endpointni chaqiradi ---
INTERNAL_WEBHOOK_SECRET=change-me-too

# --- FCM (Firebase console → Service accounts → Generate key) ---
# Yo'l yoki base64(JSON). Bo'sh bo'lsa push o'chiq, Socket.IO ishlayveradi.
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Ixtiyoriy ---
CORS_ORIGINS=
DEVICE_STORE_FILE=./data/devices.json

# --- Ilova versiyasi siyosati (GET /restaurant/v1/app/version) ---
ANDROID_MIN_VERSION=1.0.0
ANDROID_LATEST_VERSION=1.0.0
ANDROID_FORCE_UPDATE=false
